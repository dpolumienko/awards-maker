# Copy to .env. Which spelling is read depends on how the app is started:
#
#   npm run dev          reads the bare names below directly.
#   docker-compose.yml   reads them and re-exports the NUXT_ spellings, with one
#                        rename: MYSQL_USERNAME becomes NUXT_MYSQL_USER.
#   node .output/…       reads NOTHING here. nuxt.config.ts resolves these at
#                        BUILD time, so a hand-started built server can only be
#                        corrected with NUXT_MYSQL_HOST / _PORT / _USER /
#                        _PASSWORD / _DATABASE.

# ---- database ---------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=awards
MYSQL_PASSWORD=
MYSQL_DATABASE=awards_maker

# ---- session ----------------------------------------------------------------
# Seals the session cookie, at least 32 characters. Generate with:
#   openssl rand -hex 32
NUXT_SESSION_PASSWORD=

# ---- Twitch -----------------------------------------------------------------
# One application, two redirect URIs - Twitch matches them exactly and allows
# several, so register BOTH:
#   <domain>/auth/twitch        voters (user:read:email)
#   <domain>/auth/twitch-host   hosts  (the full set, as on Streams Charts)
# Do NOT set NUXT_OAUTH_TWITCH_REDIRECT_URL: it would pin both routes to one URI.
NUXT_OAUTH_TWITCH_CLIENT_ID=
NUXT_OAUTH_TWITCH_CLIENT_SECRET=

# Twitch logins that are admins from their first sign-in, comma separated. An
# admin publishes paid shows without paying, which is how the paid tier is tested.
ADMIN_TWITCH_LOGINS=streams_user2

# ---- site -------------------------------------------------------------------
# The public origin. Canonicals, sitemap, robots.txt and og:image are built from
# it; a production server with anything but an https host fails /healthz.
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Production: NUXT_PUBLIC_SITE_URL=https://awards.streamscharts.com
# Any non-production deploy: NUXT_SITE_ENV=staging keeps it out of search.
# Search Console HTML-tag verification (optional if verified by DNS):
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# The host Twitch checks a clip embed's `parent` against. Leave empty in dev.
NUXT_PUBLIC_SITE_HOST=

# Where uploaded covers and nominee images land. A volume in Docker.
UPLOADS_DIR=./.uploads

# ---- payments (optional) ----------------------------------------------------
# Without a key the checkout answers 503 and says so; nothing else changes.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
